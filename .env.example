# Copia este archivo a .env. Opcional: crea .env.local con solo tus overrides (DB_*, claves, etc.);
# .env.local se carga después de .env y tiene prioridad. Ver README_INSTRUCCIONES.md

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=winetwork_main
DB_USERNAME=username
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# HubSpot (CRM + transactional email). Optional for local dev: leave empty and HubSpot calls are skipped where configured.
HUBSPOT_ACCESS_TOKEN=

# Stripe / Laravel Cashier (vendor subscription checkout + billing portal + webhook sync).
# STRIPE_KEY is the publishable key, STRIPE_SECRET is the secret key, STRIPE_WEBHOOK_SECRET is the
# signing secret for the /stripe/webhook endpoint (Stripe Dashboard > Developers > Webhooks).
# STRIPE_VENDOR_PRICE_ID is the Stripe Price id for the "WIN Subscription" product — test-mode and
# live-mode Stripe accounts each have their OWN price id for "the same" product, so this must be
# set per environment rather than hardcoded in the controller.
# Rotate keys if they were ever committed to version control.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_VENDOR_PRICE_ID=

# Legacy raw Stripe payment-links flow (app/Models/Payment.php) — not used by the live Cashier
# checkout flow (VendorController::attemptPayment), kept only if that legacy path is still needed.
STRIPE_PAYMENT_LINK_PRICE=
STRIPE_CHECKOUT_SUCCESS_URL=

# Klaviyo (server-side event tracking). Private API Key from Klaviyo > Settings > API Keys.
# Leave empty and Klaviyo calls are skipped, same as HubSpot.
KLAVIYO_API_KEY=
KLAVIYO_ENABLED=true

# Shared secret for GET /cron/run-schedule (see routes/web.php) — an external HTTP-pinging
# cron service (e.g. cron-job.org) hits this URL with ?token=<this value> once a minute to
# drive Laravel's scheduler, since this container has no real server crontab. Generate a
# long random value, e.g. `php artisan tinker --execute="echo Str::random(40);"`.
CRON_SECRET=

# Vendor "Early Adopter" badge: vendors who join within 3 months of this date earn it,
# permanently. Format: YYYY-MM-DD.
RELAUNCH_DATE=
